# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
# true behind a proxy (default: true in Lambda) so rate limiting sees the client address
TRUST_PROXY=false

# Requests per minute and client address (raise it for load tests)
RATE_LIMIT_PER_MINUTE=60

# Cache (local: docker compose up redis). Leave REDIS_URL empty to run without a cache.
REDIS_URL=redis://localhost:6379
CACHE_TTL_CATALOGUE_SECONDS=60
CACHE_TTL_REPORTS_SECONDS=30
# In AWS the URL may instead be an SSM SecureString parameter name:
# REDIS_URL_PARAM=/checkout/<stage>/cache/redis-url

# DynamoDB (local: docker compose up dynamodb)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_PRODUCTS=checkout-local-products
TABLE_CUSTOMERS=checkout-local-customers
TABLE_TRANSACTIONS=checkout-local-transactions
TABLE_DELIVERIES=checkout-local-deliveries

# Fees (integer cents, COP)
BASE_FEE_IN_CENTS=250000
DELIVERY_FEE_IN_CENTS=800000

# Payment gateway — sandbox values from the assessment brief (do not commit real values)
PAYMENT_GATEWAY_BASE_URL=<sandbox-base-url-ending-in-/v1>
PAYMENT_GATEWAY_PUBLIC_KEY=<public-key>
PAYMENT_GATEWAY_PRIVATE_KEY=<private-key>
PAYMENT_GATEWAY_INTEGRITY_SECRET=<integrity-secret>
PAYMENT_GATEWAY_EVENTS_SECRET=<events-secret>
# In AWS the three secrets may instead be SSM SecureString parameter names (an env value wins):
# PAYMENT_GATEWAY_PRIVATE_KEY_PARAM=/checkout/<stage>/payment-gateway/private-key
# PAYMENT_GATEWAY_INTEGRITY_SECRET_PARAM=/checkout/<stage>/payment-gateway/integrity-secret
# PAYMENT_GATEWAY_EVENTS_SECRET_PARAM=/checkout/<stage>/payment-gateway/events-secret
PAYMENT_GATEWAY_TIMEOUT_MS=8000
PAYMENT_POLL_MAX_MS=9000
PAYMENT_POLL_INTERVAL_MS=1500
