# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# DynamoDB (local: docker compose up dynamodb)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_PRODUCTS=checkout-local-products
TABLE_CUSTOMERS=checkout-local-customers
TABLE_TRANSACTIONS=checkout-local-transactions
TABLE_DELIVERIES=checkout-local-deliveries

# Fees (integer cents, COP)
BASE_FEE_IN_CENTS=250000
DELIVERY_FEE_IN_CENTS=800000

# Payment gateway — sandbox values from the assessment brief (do not commit real values)
PAYMENT_GATEWAY_BASE_URL=<sandbox-base-url-ending-in-/v1>
PAYMENT_GATEWAY_PUBLIC_KEY=<public-key>
PAYMENT_GATEWAY_PRIVATE_KEY=<private-key>
PAYMENT_GATEWAY_INTEGRITY_SECRET=<integrity-secret>
PAYMENT_GATEWAY_EVENTS_SECRET=<events-secret>
PAYMENT_GATEWAY_TIMEOUT_MS=8000
PAYMENT_POLL_MAX_MS=9000
PAYMENT_POLL_INTERVAL_MS=1500
